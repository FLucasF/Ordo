<?xml version="1.0" encoding="utf-8"?>
<!-- The last half hour of an entry that lasts, with its end at the bottom; it grows with the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_block_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/widget_block_end_time"
        android:layout_width="58dp"
        android:layout_height="match_parent"
        android:gravity="bottom|start"
        android:singleLine="true"
        android:textColor="#66FFFFFF"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_block_box"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_block_end_bg" />
</LinearLayout>
